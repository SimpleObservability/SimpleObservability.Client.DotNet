<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>WorldDomination.SimpleObservability</PackageId>
    <Title>Simple: Observability client</Title>
    <Company>World Domination Technolgoies Pty. Ltd.</Company>
    <Description>Core library for Simple Observability health check schema. Use this to implement the /healthz endpoint in your services.</Description>
    <Authors>Justin Adler</Authors>
    <Product>Simple Observability Client</Product>
    <Copyright>2025</Copyright>
    <PackageIcon>icon.jpg</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/SimpleObservability/SimpleObservability.Client.DotNet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageTags>health;observability;monitoring;healthcheck;world-domination</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\icon.jpg">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\LICENSE.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
  </ItemGroup>

</Project>
